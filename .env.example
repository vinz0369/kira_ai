# Safe development placeholders. Copy to .env and replace all "change-me" values.
FASTAPI_ENV=development
PROJECT_NAME="AI Live Character"
MOCK_MODE=true
SECRET_KEY=change-me-with-a-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-strong-password
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql://postgres:change-me-database-password@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
FRONTEND_HOST=http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=false
SMTP_PORT=1025

# Phase 2 YouTube OAuth. Keep all secrets backend-only; never use VITE_* names.
# Generate DATA_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_INGEST_TRANSPORT=stream
YOUTUBE_RECONNECT_MAX_SECONDS=30
# Temporary chat test behavior: all = consider every new nonempty chat;
# addressed = only questions naming Kira. Set addressed for quieter streams.
YOUTUBE_CHAT_RESPONSE_MODE=all

# Phase 3 real voice. All variables below are read by the backend only.
# Never create VITE_* copies and never paste service-account JSON into the UI.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
DEEPGRAM_LANGUAGE=vi
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=180
DEFAULT_REAL_LLM_PROVIDER=fpt
FPT_API_KEY=
FPT_API_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_LLM_MODEL=Saola-Small-32B
FPT_LLM_MODELS=Saola-Small-32B,Llama-3.3-70B-Instruct,DeepSeek-V4-Flash,GLM-5.2,Qwen3.6-27B,Qwen3.8-27B,gpt-oss-120b
FPT_LLM_MAX_OUTPUT_TOKENS=180
FPT_LLM_TIMEOUT_SECONDS=30
# Use an absolute path outside the repository in production. Google ADC is
# loaded server-side; the JSON file must not be committed.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_LOCATION=global
GOOGLE_TTS_VOICE_ID=vi-VN-Chirp3-HD-Leda
GOOGLE_TTS_LANGUAGE=vi-VN
GOOGLE_TTS_SAMPLE_RATE_HZ=24000
# Credential-free alternatives. gTTS is the default for Voice Real and still
# requires outbound internet. Edge uses an unofficial endpoint and is opt-in.
DEFAULT_REAL_TTS_PROVIDER=gtts
FREE_TTS_SAMPLE_RATE_HZ=24000
GTTS_LANGUAGE=vi
GTTS_TLD=com
GTTS_TIMEOUT_SECONDS=15
EDGE_TTS_EXPERIMENTAL_ENABLED=false
EDGE_TTS_VOICE_ID=vi-VN-HoaiMyNeural
EDGE_TTS_RATE=+0%
VOICE_MAX_AUDIO_FRAME_BYTES=32000
VOICE_CONTEXT_TURNS=6
VOICE_RECONNECT_MAX_SECONDS=20

# Optional operator-supplied rates for estimates. Leave blank rather than
# hard-coding vendor prices; usage remains available with estimated_usd=null.
VOICE_STT_USD_PER_MINUTE=
VOICE_LLM_INPUT_USD_PER_MILLION_TOKENS=
VOICE_LLM_OUTPUT_USD_PER_MILLION_TOKENS=
FPT_LLM_INPUT_USD_PER_MILLION_TOKENS=
FPT_LLM_OUTPUT_USD_PER_MILLION_TOKENS=
VOICE_TTS_USD_PER_MILLION_CHARACTERS=
