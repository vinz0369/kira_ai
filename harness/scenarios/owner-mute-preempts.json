{
  "id": "owner-mute-preempts",
  "description": "P0 mute during AI playback cancels immediately",
  "initial_state": {
    "session": "active",
    "ai_muted": false,
    "ai_speaking": true,
    "streamer_speaking": false
  },
  "events": [
    {
      "type": "session.control",
      "payload": {
        "command": "mute"
      }
    }
  ],
  "expect": {
    "decision": "cancel",
    "ai_muted": true,
    "active_utterances": 0,
    "speech_cancelled": true
  }
}
