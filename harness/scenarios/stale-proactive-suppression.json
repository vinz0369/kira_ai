{
  "id": "stale-proactive-suppression",
  "description": "proactive response should not play after stale generation",
  "initial_state": {
    "session": "active",
    "ai_muted": false,
    "ai_speaking": false,
    "streamer_speaking": false
  },
  "events": [
    {
      "type": "system.test.candidate_expired",
      "payload": {
        "utterance_id": "utter-1",
        "expired": true
      }
    }
  ],
  "expect": {
    "decision": "cancel",
    "speech_started": false
  }
}
